# CPA Usage Keeper Enterprise — 配置模板
# 复制此文件为 .env 并填入必填项后运行 install.sh

# =============================================================================
# 必填配置
# =============================================================================

# CPA 服务地址（Keeper 通过此地址拉取用量数据）
# Docker Compose 内通常为 http://cli-proxy-api:8317
CPA_BASE_URL=http://host.docker.internal:8317

# CPA 管理密钥，必须与 CPA config.yaml 中 remote-management.secret-key 一致
CPA_MANAGEMENT_KEY=your-cpa-management-key

# 管理面板登录密码
LOGIN_PASSWORD=your-admin-password

# 企业版授权密钥（可选，未来版本启用）
# LICENSE_KEY=

# =============================================================================
# 可选配置
# =============================================================================

# Web 服务端口
APP_PORT=4320

# Redis 队列地址（留空自动从 CPA_BASE_URL 推断）
# REDIS_QUEUE_ADDR=

# 部署子路径（如 /keeper）
# APP_BASE_PATH=

# 业务时区
TZ=Asia/Shanghai

# 是否启用登录保护
AUTH_ENABLED=true

# 工作目录（SQLite 数据库、日志、备份存放位置）
WORK_DIR=./data