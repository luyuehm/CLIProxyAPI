# ──────────────────────────────────────────────────────────────────────
#  CPA Usage Keeper Enterprise — config.yaml 模板（参考）
#
#  CPA Usage Keeper 本身是纯 Go 应用，所有配置通过 .env 环境变量管理，
#  无需独立的 config.yaml 文件。
#
#  本文件仅作为 CPA 核心引擎 config.yaml 配置的参考文档。
#  请根据你的 CPA 部署方式，在 CPA 的 config.yaml 中开启以下选项：
# ──────────────────────────────────────────────────────────────────────

# ── CPA 管理 API（Keeper 通过此接口拉取配置和用量数据） ──────────
# remote-management:
#   # 允许非 localhost 访问（容器内通信需要）
#   allow-remote: true
#   # 管理密钥，必须与 .env 中 CPA_MANAGEMENT_KEY 完全一致
#   secret-key: "your-cpa-management-key"

# ── 用量统计（Keeper 通过 RESP 协议订阅 CPA 用量数据） ──────────
# usage-statistics-enabled: true
# redis-usage-queue-retention-seconds: 60

# 注意：修改 CPA 的 config.yaml 后需要重启 CPA 服务生效。