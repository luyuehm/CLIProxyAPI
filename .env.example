# ── AI Gateway Enterprise 配置模板 ─────────────────────────────────
# 使用前复制此文件为 .env，填入实际值
# 重要：CPA_MANAGEMENT_KEY 必须与 enterprise/config.yaml 中
#       remote-management.secret-key 的值完全一致（明文一致即可）
# ────────────────────────────────────────────────────────────────────

# 授权密钥（必填）
# 购买企业版后获取 LICENSE_KEY，未设置时服务将拒绝启动
LICENSE_KEY=

# CPA 管理密钥（必填）
# 必须与 enterprise/config.yaml 中 remote-management.secret-key 的值完全一致。
# KEEPER 使用它通过 TCP RESP 协议认证到 CPA 的 management 端口（8317）。
CPA_MANAGEMENT_KEY=change-me-enterprise-management-key

# 管理面板登录密码（必填）
# 登录 KEEPER 管理面板 (http://localhost:4320) 使用
LOGIN_PASSWORD=

# ── 端口配置（可选，默认即可） ────────────────────────────────────

# CPA 路由引擎端口
CPA_PORT=8317

# KEEPER 管理面板端口
KEEPER_PORT=4320

# ── KEEPER 配置（可选） ───────────────────────────────────────────

# CPA 基础 URL（容器内通信，通常不需要改）
CPA_BASE_URL=http://cpa:8317

# ── 高级配置（可选） ──────────────────────────────────────────────

# 授权验证服务器地址（可选）
# 留空 = 离线模式：仅校验 LICENSE_KEY 已填写，不依赖外部网络（适合私有化/内网部署）
# 配置后 = 在线模式：服务启动前向该地址发起远程验证，服务端需返回 {"valid":true}
# 示例: LICENSE_SERVER_URL=https://license.example.com/verify
LICENSE_SERVER_URL=